# ============================================================================
# 『Komame』本番環境用 環境変数設定ファイル (.env.production)
# ----------------------------------------------------------------------------
# 使用方法:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   ※ 以下の POSTGRES_PASSWORD と JWT_SECRET を必ずランダムな値に変更してください
# ============================================================================

# 1. PostgreSQL 16 データベース設定
#    例: openssl rand -hex 24 で生成した強力なパスワードを設定
POSTGRES_USER=komame_prod_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_DB_PASSWORD_2026
POSTGRES_DB=komame_prod_db

# 2. JWT セッション暗号化シークレットキー (必須: 32文字以上・サンプル値不可)
#    ※ 本番環境では未設定・32文字未満・サンプル値の場合、Fail-Fast 機能により起動が拒否されます。
#    生成コマンド例: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_BASE64_48_CHARACTERS_MINIMUM

# 3. アプリケーション基本設定
PORT=3080
LOG_LEVEL=info

# 4. 初期セットアップ（npm run db:seed 実行時のみ使用）
#    ※ Web UI の「新規世帯を作成 (サインアップ)」から登録する場合は変更不要です
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMeStrongPass123!
DEFAULT_HOUSEHOLD_NAME=わが家の家計簿
